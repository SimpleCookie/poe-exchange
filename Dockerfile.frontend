FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_EXCHANGE_CLIENT=api
ARG VITE_POE_PROXY_BASE_URL=/api/poe
ENV VITE_EXCHANGE_CLIENT=$VITE_EXCHANGE_CLIENT
ENV VITE_POE_PROXY_BASE_URL=$VITE_POE_PROXY_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
