FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_EXCHANGE_CLIENT=api
ARG VITE_POE_PROXY_BASE_URL=/api/poe
ENV VITE_EXCHANGE_CLIENT=$VITE_EXCHANGE_CLIENT
ENV VITE_POE_PROXY_BASE_URL=$VITE_POE_PROXY_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY docker/nginx/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
COPY --from=build /app/dist /usr/share/nginx/html

# Default upstream matches the service name in docker-compose.yml for local dev.
# Override with POE_PROXY_UPSTREAM in production (e.g. http://poe-exchange-proxy:8787).
ENV POE_PROXY_UPSTREAM=http://proxy:8787

EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
