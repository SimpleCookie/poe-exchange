POE_CLIENT_ID=your-client-id
POE_CLIENT_SECRET=replace-me
POE_CONTACT=you@example.com
POE_APP_VERSION=0.1.0
POE_USER_AGENT_SUFFIX=PoE Exchange Profit Calc Proxy
POE_SCOPE=service:cxapi service:leagues
POE_PROXY_PORT=8787

# Domain for the per-browser session cookie (Set-Cookie `Domain` attribute).
# Only needed if the frontend and the OAuth callback are served from different subdomains
# (e.g. frontend on app.example.com, backend/callback on api.example.com) -- set it to the
# shared parent domain (e.g. example.com) so the session survives the OAuth redirect.
# Leave unset when frontend and backend share the exact same host.
POE_SESSION_COOKIE_DOMAIN=

# Optional stash holdings map used by the frontend for affordability estimates.
# Format: {"LeagueName":{"currencyCode":amount}}
POE_STASH_CURRENCIES_JSON={"Settlers":{"chaos":1800,"divine":8},"Standard":{"chaos":4200,"divine":30}}
